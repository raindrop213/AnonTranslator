{
  "manifest_version": 3,
  "name": "AnonTranslator",
  "version": "1.3.0",
  "author": "raindrop213",
  "description": "Japanese light novel reading tool",
  "icons": { "16": "assets/img/icon16.png", "48": "assets/img/icon48.png", "128": "assets/img/icon128.png" },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*", "https://translate-pa.googleapis.com/*", "https://m.youdao.com/*", "https://translate.volcengine.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{ "matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle", "js": ["content.js"], "css": ["reader.css"] }],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" }
}
